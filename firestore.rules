rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات التطبيق الأساسية (العمال، المستخدمين، الشفتات...)
    match /core/{docId} {
      allow read, write: if request.auth != null;
    }

    // التقارير اليومية
    match /reports/{docId} {
      allow read, write: if request.auth != null;
    }

    // ملاحظات المخزن
    match /warehouseTasks/{docId} {
      allow read, write: if request.auth != null;
    }

    // الإجازات
    match /leaves/{docId} {
      allow read, write: if request.auth != null;
    }

    // تغييرات الشفتات
    match /shiftChanges/{docId} {
      allow read, write: if request.auth != null;
    }

    // 🪵 إدارة البلتات (جديد)
    match /pallets/{docId} {
      allow read, write: if request.auth != null;
    }

    // الحالات اليومية / سجل التعديلات (Audit Log) / سجل التحميل والتفريغ
    // ملحوظة: هذه الـ Collections موجودة فعليًا في كود التطبيق (workerStatuses,
    // auditLog, loadUnloadLog) لكنها كانت غير موجودة في قواعد الحماية القديمة،
    // فكانت كتابتها على Firestore تُرفض تلقائيًا بسبب قاعدة "الرفض الافتراضي"
    // في آخر الملف. تمت إضافتها هنا حتى تتم مزامنتها فعليًا مثل باقي البيانات.
    match /workerStatuses/{docId} {
      allow read, write: if request.auth != null;
    }
    match /auditLog/{docId} {
      allow read, write: if request.auth != null;
    }
    match /loadUnloadLog/{docId} {
      allow read, write: if request.auth != null;
    }

    // أي حاجة تانية غير معرّفة فوق: ممنوعة تمامًا افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
