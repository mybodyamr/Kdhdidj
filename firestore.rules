rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات التطبيق الأساسية (العمال، المستخدمين، الشفتات...)
    match /core/{docId} {
      allow read, write: if request.auth != null;
    }

    // التقارير اليومية
    match /reports/{docId} {
      allow read, write: if request.auth != null;
    }

    // ملاحظات المخزن
    match /warehouseTasks/{docId} {
      allow read, write: if request.auth != null;
    }

    // الإجازات
    match /leaves/{docId} {
      allow read, write: if request.auth != null;
    }

    // تغييرات الشفتات
    match /shiftChanges/{docId} {
      allow read, write: if request.auth != null;
    }

    // أي حاجة تانية غير معرّفة فوق: ممنوعة تمامًا افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
